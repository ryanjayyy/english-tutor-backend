# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/english_coach?schema=public"

# Auth: long random string (at least 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# AI tutor provider: "claude" (paid) or "gemini" (Google, has a free tier)
AI_PROVIDER=claude

# Claude: an Anthropic API key (https://console.anthropic.com)
AI_API_KEY=
AI_MODEL=claude-opus-5

# Gemini: a Google AI Studio key (https://aistudio.google.com, free tier available)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Speech-to-text: a Deepgram API key (https://console.deepgram.com)
SPEECH_TO_TEXT_API_KEY=
SPEECH_TO_TEXT_MODEL=nova-3

# Social sign-in (comma-separated). Leave empty to disable a provider.
# Google: your iOS, Android and Web OAuth client IDs.
GOOGLE_CLIENT_IDS=
# Apple: your iOS bundle ID (and Services ID if you add web sign-in).
APPLE_AUDIENCES=com.englishcoach.app

# Only needed for web clients; native apps don't send an Origin header.
CORS_ORIGINS=
